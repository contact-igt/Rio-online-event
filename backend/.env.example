# Development placeholders only. Copy to .env.development.local and replace the values locally.
# Railway production variables belong in Railway runtime settings.
NODE_ENV=development
APP_ENV=development
DB_DIALECT=mysql
DB_ENGINE=mariadb
DB_ALLOWED_HOST=127.0.0.1
DB_ALLOWED_DATABASE=rio_hospital
DATABASE_URL=mysql://rio_app:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:3306/rio_hospital
ALLOWED_ORIGINS=http://localhost:3001
PUBLIC_ORIGINS=http://localhost:3000
# Confirmation e-mail after a registration is submitted (Resend). Off unless RIO_EMAIL_ENABLED=yes AND the key and sender are set.
# RIO_EMAIL_FROM is "Name <address>" on a domain verified in Resend. Set real values only in Railway, never in this file.
RIO_EMAIL_ENABLED=
RESEND_API_KEY=
RIO_EMAIL_FROM=
RIO_EMAIL_REPLY_TO=
