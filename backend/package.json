{
  "name": "@rio/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "nodemon --watch src --ext ts,json --exec \"node --env-file-if-exists=.env src/server.ts\"",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "node --env-file-if-exists=.env src/db/cli.ts migrate",
    "db:status": "node --env-file-if-exists=.env src/db/cli.ts status",
    "db:drop": "node --env-file-if-exists=.env src/db/cli.ts drop",
    "db:verify": "node --env-file-if-exists=.env src/db/cli.ts verify",
    "staff:seed-super-admin": "node --env-file-if-exists=.env src/auth/cli.ts seed-super-admin",
    "staff:create-admin": "node --env-file-if-exists=.env src/auth/cli.ts create-admin",
    "staff:reset-password": "node --env-file-if-exists=.env src/auth/cli.ts reset-password",
    "db:seed:events": "node --env-file-if-exists=.env src/db/seed-events-cli.ts",
    "migrate:dev": "node --env-file=.env src/db/cli.ts migrate",
    "db:status:dev": "node --env-file=.env src/db/cli.ts status",
    "db:seed:events:dev": "node --env-file=.env src/db/seed-events-cli.ts",
    "staff:seed-super-admin:dev": "node --env-file=.env src/auth/cli.ts seed-super-admin",
    "staff:create-admin:dev": "node --env-file=.env src/auth/cli.ts create-admin",
    "staff:reset-password:dev": "node --env-file=.env src/auth/cli.ts reset-password",
    "test:local": "node --env-file-if-exists=.env.test.local node_modules/vitest/vitest.mjs run",
    "test:mariadb": "node --env-file-if-exists=.env.test.local src/db/test-mariadb.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1166.0",
    "@aws-sdk/s3-request-presigner": "^3.1166.0",
    "express": "^5.2.1",
    "kysely": "^0.29.8",
    "mysql2": "^3.24.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.5",
    "nodemon": "^3.1.14",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.1.0"
  }
}
